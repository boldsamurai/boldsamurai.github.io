---
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
---

<section class="section" id="contact">
  <h2 class="section-title reveal">{tr.contact.title}</h2>
  <p class="contact-desc reveal reveal-delay-1">{tr.contact.description}</p>

  <div class="contact-links reveal reveal-delay-2">
    <a href="mailto:aczarnowski99@gmail.com" class="contact-card">
      <div class="contact-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z"/><path d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z"/>
        </svg>
      </div>
      <div class="contact-info">
        <span class="contact-label">{tr.contact.email}</span>
        <span class="contact-value">aczarnowski99@gmail.com</span>
      </div>
      <svg class="contact-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/>
      </svg>
    </a>

    <a href="https://github.com/boldsamurai" target="_blank" rel="noopener" class="contact-card">
      <div class="contact-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </div>
      <div class="contact-info">
        <span class="contact-label">GitHub</span>
        <span class="contact-value">boldsamurai</span>
      </div>
      <svg class="contact-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/>
      </svg>
    </a>

    <a href="https://linkedin.com/in/adcz99" target="_blank" rel="noopener" class="contact-card">
      <div class="contact-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </div>
      <div class="contact-info">
        <span class="contact-label">LinkedIn</span>
        <span class="contact-value">in/adcz99</span>
      </div>
      <svg class="contact-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/>
      </svg>
    </a>
  </div>
</section>

<style>
  .contact-desc {
    font-size: 1rem;
    margin-bottom: 2rem;
    max-width: 40rem;
  }

  .contact-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    color: inherit;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(12px);
    transition: all 0.3s ease;
  }

  .contact-card:hover {
    border-color: var(--accent-blue);
    box-shadow: var(--shadow), 0 0 20px var(--glow-blue);
    transform: translateY(-3px);
  }

  .contact-card:hover .contact-icon {
    background: var(--accent-blue);
    box-shadow: 0 0 16px var(--glow-blue);
  }

  .contact-card:hover .contact-icon svg {
    color: #fff;
    fill: #fff;
  }

  .contact-card:hover .contact-arrow {
    transform: translate(2px, -2px);
    color: var(--accent-blue);
  }

  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--glow-blue);
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .contact-icon svg {
    color: var(--accent-blue);
    fill: var(--accent-blue);
    transition: all 0.3s ease;
  }

  .contact-info {
    flex: 1;
  }

  .contact-label {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.2rem;
  }

  .contact-value {
    display: block;
    font-size: 0.9rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .contact-arrow {
    color: var(--text-muted);
    flex-shrink: 0;
    transition: all 0.3s ease;
  }
</style>
